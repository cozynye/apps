# Copy to .env. Never commit .env.
# RevenueCat public iOS SDK keys (P17). test_ keys = RevenueCat Test Store (dev only).
EXPO_PUBLIC_RC_IOS_KEY_NUNI=
EXPO_PUBLIC_RC_IOS_KEY_FOURPOP=
# Cloudflare R2 public base URL for manifest.json and packs (P19)
EXPO_PUBLIC_CDN_BASE_URL=
# development | preview | production
EXPO_PUBLIC_ENV=development
# Force UI language for E2E screenshots: en | vi | th | ko
EXPO_PUBLIC_FORCE_LOCALE=
# Firebase (P18): put GoogleService-Info.plist in apps/<app>/ (gitignored), or point to it here
# (EAS: file secret). Without a plist the app builds without Firebase (events stay in the dev log).
GOOGLE_SERVICES_PLIST_NUNI=
