{
  "name": "@nf/db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.nuni.config.ts && drizzle-kit generate --config drizzle.fourpop.config.ts && tsx scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "uuidv7": "^1.2.1"
  },
  "peerDependencies": {
    "expo-sqlite": "*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./nuni": "./src/nuni/index.ts",
    "./fourpop": "./src/fourpop/index.ts"
  }
}
