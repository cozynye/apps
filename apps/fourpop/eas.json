{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "TC547C863K",
        "metadataPath": "./store.config.json",
        "ascAppId": "6821789911",
        "ascApiKeyPath": "../nuni/AuthKey_Z3256B5QP4.p8",
        "ascApiKeyId": "Z3256B5QP4",
        "ascApiKeyIssuerId": "ac23b078-5da3-4649-9841-199114b59e2e"
      }
    }
  }
}
