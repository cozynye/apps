{
  "name": "nuni-fourpop",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "nuni": "pnpm --filter nuni run",
    "typecheck": "tsc --noEmit -p . && pnpm -r --parallel run typecheck",
