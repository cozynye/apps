    "fourpop": "pnpm --filter fourpop run"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
