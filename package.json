    "cdn:mock": "tsx scripts/mock-cdn.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "markdown-it": "^14.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
