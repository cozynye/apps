{
  "name": "nuni-fourpop",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "nuni": "pnpm --filter nuni run",
    "typecheck": "tsc --noEmit -p . && pnpm -r --parallel run typecheck",
    "test": "jest",
    "lint": "eslint apps packages scripts web",
    "i18n:check": "tsx packages/i18n/scripts/check.ts",
    "design:sync": "tsx scripts/design-sync.ts",
    "fourpop": "pnpm --filter fourpop run",
    "legal:build": "tsx web/legal/build.ts",
